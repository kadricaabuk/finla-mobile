    "@remotion/google-fonts": "^4.0.523",
    "@remotion/tailwind-v4": "4.0.523",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.523",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
