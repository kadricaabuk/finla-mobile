# Finla Edge Functions secret'ları — tek kaynak bu dosya.
# `npm run supabase:start` öncesi otomatik olarak supabase/functions/.env'e kopyalanır
# (Supabase CLI sadece oradan okur).
#
# ÖNEMLİ: SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY buraya YAZMA.
# Yerel stack (`supabase start`) bu değişkenleri Edge runtime'a kendisi verir.
#
# Akış: npm run supabase:start  (functions/.env otomatik senkron)
# İsteğe bağlı hot-reload: npm run supabase:functions

AUTH_MASTER_KEY=
AUTH_JWT_SECRET=
AUTH_REFRESH_PEPPER=
AUTH_OTP_DEBUG=true
GIB_ENV=TEST
MYSOFT_MOCK=false
MYSOFT_API_URL=https://edocumentapi.mytest.tr
# Okşan'dan alınan iş ortağı API kullanıcısı (asla commit etmeyin)
MYSOFT_USERNAME=
MYSOFT_PASSWORD=
# Opsiyonel: gbAlias getUserCompanyInfo'dan gelmezse (sandbox: urn:mail:asdgb@5)
# MYSOFT_DEFAULT_GB_ALIAS=
ANTHROPIC_API_KEY=
