# Expo — kopyala: cp .env.example .env.local
#
# Tam yerel (`npm run supabase:start` sonrası):
# 127.0.0.1 yeterli — uygulama iOS/Android için host'u runtime'da çözer:
#   iOS simülatör → 127.0.0.1
#   Android emülatör → 10.0.2.2
#   Fiziksel cihaz → Metro'nun LAN IP'si (192.168.x.x)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Yerel anon key buluta ait olamaz — mutlaka aynı terminalde:
#   npm run supabase:status:env
EXPO_PUBLIC_SUPABASE_ANON_KEY=<çıktıdaki ANON_KEY>
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:54321/functions/v1
#
# Hosted projeye bağlanırken:
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_API_BASE_URL=https://your-project.supabase.co/functions/v1
#
# Edge Functions ortamı (Deno): supabase/.env.example → supabase/.env
# Serve: npm run supabase:functions
