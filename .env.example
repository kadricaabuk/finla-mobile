# Finla env template — copy to .env (and optionally .env.local). Never commit real values.
#
# One env for everything:
#   .env        defaults, pointing at the REMOTE project (TestFlight, Maestro on a Release build)
#   .env.local  optional overrides (e.g. local Supabase); wins over .env for every key
# Expo and the Supabase CLI load both files automatically; `npm run maestro*` sources both.
# Expo loads .env.local in production builds too — rename it before a TestFlight build.

# ── App (Expo) ─────────────────────────────────────────────────────────────
# EXPO_PUBLIC_* is inlined into the JS bundle; never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://your-project.supabase.co/functions/v1
#
# Local Supabase — put these in .env.local (anon key: npm run supabase:status:env).
# 127.0.0.1 is enough; lib/dev-api-host.ts rewrites it per device (Android emulator,
# physical device via the Metro host).
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:54321/functions/v1

# ── Edge Functions (local runtime) ─────────────────────────────────────────
# Passed to Deno via supabase/config.toml [edge_runtime.secrets] — add new keys there too.
# The hosted project reads its secrets from the Supabase dashboard.
# Never set SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: the local stack injects them.
#
# Generate once:
#   AUTH_MASTER_KEY      openssl rand -base64 32
#   AUTH_JWT_SECRET      openssl rand -hex 32
#   AUTH_REFRESH_PEPPER  openssl rand -hex 24
AUTH_MASTER_KEY=
AUTH_JWT_SECRET=
AUTH_REFRESH_PEPPER=
AUTH_OTP_DEBUG=true
MYSOFT_MOCK=false
MYSOFT_API_URL=https://edocumentapi.mytest.tr
# E-invoice provider partner API user (never commit)
MYSOFT_USERNAME=
MYSOFT_PASSWORD=
ANTHROPIC_API_KEY=

# ── Maestro ────────────────────────────────────────────────────────────────
# The Maestro CLI injects MAESTRO_* shell vars into flows. Staging user must exist
# with tenant linked and onboarding complete. CI sets these from GitHub secrets.
MAESTRO_TEST_PHONE=5551234567
MAESTRO_TEST_PIN=123456
