  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "export": "remotion render FinlaIntro out/finla-intro.mp4",
    "export:story": "remotion render FinlaIntroPortrait out/finla-intro-story.mp4",
    "export:outro": "remotion render FinlaOutro out/finla-outro.mp4",
    "export:inbox": "remotion render FinlaInbox out/finla-inbox.mp4",
    "export:incoming-invoice": "remotion render FinlaInbox out/finla-incoming-invoice.mp4",
    "export:incoming-invoice-story": "remotion render FinlaInboxPortrait out/finla-incoming-invoice-story.mp4",
    "export:all": "npm run export && npm run export:outro && npm run export:incoming-invoice"
  },
  "sideEffects": [
    "*.css"
  ]
