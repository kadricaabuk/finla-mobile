{
  "name": "finla",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bash scripts/resolve-local-expo-env.sh && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "bash scripts/resolve-local-expo-env.sh && expo run:android",
    "ios": "bash scripts/resolve-local-expo-env.sh && expo run:ios",
    "ios:clean": "npm run ios -- --clear",
    "ios:open": "open ios/finla.xcworkspace",
    "web": "expo start --web",
    "lint": "expo lint",
    "docs:check": "bash scripts/docs-check.sh",
    "test:chat": "bash scripts/deno-test.sh supabase/functions/chat/intents.test.ts supabase/functions/chat/date-range.test.ts supabase/functions/chat/invoice-workflow.test.ts supabase/functions/chat/chat-history.test.ts supabase/functions/chat/invoice-tax.test.ts",
    "test:auth-lock": "bash scripts/deno-test.sh lib/app-lock-policy.test.ts",
    "test:linear": "node --test \"scripts/linear-automation/*.test.mjs\"",
    "test:telegram": "node --test \"scripts/telegram/*.test.mjs\"",
    "test:qa-agent": "node --test \"scripts/qa-agent/*.test.mjs\"",
    "qa:catalog": "node scripts/qa-agent/cli.mjs catalog",
    "qa:suite": "node scripts/qa-agent/cli.mjs suite",
    "qa:seed": "node scripts/qa-agent/cli.mjs seed",
    "qa:run": "bash scripts/qa-agent/run.sh",
    "maestro:login": "bash scripts/maestro-test.sh .maestro/flows/login.yaml",
    "maestro:smoke": "bash scripts/maestro-test.sh .maestro/flows/smoke.yaml",
    "maestro:chat": "bash scripts/maestro-test.sh .maestro/flows/chat-send.yaml",
    "maestro:menu": "bash scripts/maestro-test.sh .maestro/flows/menu.yaml",
    "maestro:invoices": "bash scripts/maestro-test.sh .maestro/flows/invoices.yaml",
    "maestro:logout": "bash scripts/maestro-test.sh .maestro/flows/logout.yaml",
    "maestro:unlock": "bash scripts/maestro-test.sh .maestro/flows/unlock.yaml",
    "maestro:test": "bash scripts/maestro-test.sh .maestro/flows/",
    "supabase:start": "npm run supabase:ensure-env && supabase start",
    "supabase:stop": "supabase stop",
    "supabase:restart": "npm run supabase:stop && npm run supabase:start",
    "supabase:status": "supabase status",
    "supabase:status:env": "supabase status -o env",
    "supabase:db:reset": "supabase db reset",
    "supabase:ensure-env": "bash scripts/ensure-supabase-env.sh",
    "supabase:env:init": "bash scripts/init-supabase-env.sh",
    "supabase:bootstrap": "npm run supabase:env:init && npm run supabase:start",
    "supabase:functions": "npm run supabase:ensure-env && supabase functions serve --env-file supabase/.env",
    "supabase:local": "npm run supabase:start",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.104.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-print": "^55.0.13",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^55.0.18",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "supabase": "^2.95.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
