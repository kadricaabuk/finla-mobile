# Kopyala: cp supabase/.env.example supabase/.env
#
# ÖNEMLİ: SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY buraya YAZMA.
# `supabase functions serve --env-file` ile SUPABASE_* prefix'i CLI tarafından reddedilir;
# yerel stack (`npm run supabase:start`) bu değişkenleri Edge runtime'a kendisi verir.
#
# Akış: `npm run supabase:start` → ardından `npm run supabase:functions`
# (Auth/chat için AUTH_* vb. sadece bu dosyada.)

AUTH_MASTER_KEY=
AUTH_JWT_SECRET=
AUTH_REFRESH_PEPPER=
GIB_ENV=PROD
ANTHROPIC_API_KEY=
